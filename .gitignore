# ---- build output ----
bin/
obj/
publish/
[Bb]in/
[Oo]bj/
.vs/
*.user
*.suo

# ---- local dev database (SQLite fallback) ----
*.db
*.db-shm
*.db-wal

# ---- company data — never commit employee PII ----
# source data workbooks (employee names / IDs / org structure)
*.xlsx
*.xls
*.csv
# legacy embedded webapp carries employee data in data.js
/webapp/
# Nitaqat zone screenshots (company-specific)
/Levels/

# ---- deployment copies and runtime state (never commit) ----
_stage/
_releases/
_backup-*/
uploads/
# ASP.NET data-protection keys — anyone holding them can forge login cookies
dp-keys/
# large installers (GitHub rejects files over 100 MB)
*.exe
*.msi
*.bak

# ---- misc / temp ----
~$*
*.tmp
*.log
Thumbs.db

# editor / tooling
.claude/
