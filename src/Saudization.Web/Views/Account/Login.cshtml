@using System.Globalization
@model Saudization.Web.Controllers.LoginViewModel
@{
    Layout = null;
    var culture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isRtl = culture == "ar";
    var dir = isRtl ? "rtl" : "ltr";
    var otherCulture = isRtl ? "en" : "ar";
}
<!DOCTYPE html>
<html lang="@culture" dir="@dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@T["Login_Title"] · @T["AppTitle"]</title>
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <style>
        body.login-page { display: flex; align-items: center; justify-content: center; min-height: 100vh; background: linear-gradient(135deg, #0b6b3a, #0e8a4a); margin: 0; }
        .login-card { width: 100%; max-width: 380px; background: var(--card, #fff); border-radius: 14px; box-shadow: 0 18px 50px rgba(0,0,0,.25); padding: 28px 26px; }
        .login-brand { text-align: center; margin-bottom: 18px; }
        .login-brand .app { font-size: 1.25rem; font-weight: 700; color: var(--brand, #0b6b3a); }
        .login-brand .sub { color: var(--muted, #6b7280); font-size: .9rem; margin-top: 2px; }
        .login-card .field { margin-bottom: 14px; }
        .login-card .field label { display: block; margin-bottom: 5px; font-weight: 600; font-size: .9rem; }
        .login-card .field input[type=text], .login-card .field input[type=password] { width: 100%; padding: 10px 12px; border: 1px solid var(--line, #d1d5db); border-radius: 8px; box-sizing: border-box; }
        .login-card .btn { width: 100%; justify-content: center; padding: 11px; font-size: 1rem; }
        .login-remember { display: flex; align-items: center; gap: 8px; font-size: .9rem; margin-bottom: 16px; }
        .login-remember input { width: auto; }
        .login-err { background: #fdecea; color: #b3261e; border: 1px solid #f5c6cb; border-radius: 8px; padding: 9px 12px; font-size: .9rem; margin-bottom: 14px; }
        .login-lang { text-align: center; margin-top: 16px; }
        .login-lang button { background: none; border: none; color: var(--brand, #0b6b3a); cursor: pointer; font-size: .88rem; text-decoration: underline; }
    </style>
</head>
<body class="login-page @(isRtl ? "rtl" : "ltr")">
    <form class="login-card" asp-controller="Account" asp-action="Login" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ReturnUrl" />
        <div class="login-brand">
            <div class="app">@T["AppTitle"]</div>
            <div class="sub">@T["Login_Prompt"]</div>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="login-err">
                @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@e.ErrorMessage</div>
                }
            </div>
        }

        <div class="field">
            <label asp-for="Username">@T["Login_Username"]</label>
            <input asp-for="Username" type="text" autofocus autocomplete="username" dir="ltr" />
        </div>
        <div class="field">
            <label asp-for="Password">@T["Login_Password"]</label>
            <input asp-for="Password" type="password" autocomplete="current-password" dir="ltr" />
        </div>
        <label class="login-remember">
            <input asp-for="RememberMe" type="checkbox" /> @T["Login_Remember"]
        </label>
        <button class="btn" type="submit">@T["Login_Submit"]</button>
    </form>

    <form class="login-lang" asp-controller="Home" asp-action="SetLanguage" method="post"
          style="position:fixed; bottom:18px; inset-inline:0;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="culture" value="@otherCulture" />
        <input type="hidden" name="returnUrl" value="@Url.Action("Login")" />
        <button type="submit" style="color:#fff;">@(isRtl ? T["Lang_English"] : T["Lang_Arabic"])</button>
    </form>
</body>
</html>
