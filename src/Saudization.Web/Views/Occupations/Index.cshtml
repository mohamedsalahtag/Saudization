@model List<Saudization.Web.Controllers.UnmappedOccupation>
@{
    ViewData["Title"] = T["Occ_Title"].Value;
    var cats = ViewBag.Categories as List<SaudizationCategory> ?? new();
    var guide = ViewBag.GuideByCategory as List<Saudization.Web.Controllers.CatSummary> ?? new();
    var allOcc = ViewBag.AllOccupations as List<Saudization.Web.Controllers.OccRow> ?? new();
    var snaps = ViewBag.Snapshots as List<Snapshot> ?? new();
    var sid = (int)(ViewBag.SnapshotId ?? 0);
    int totalEmp = (int)(ViewBag.TotalEmp ?? 0);
    int unclEmp = (int)(ViewBag.UnclassifiedEmp ?? 0);
    int unclOcc = (int)(ViewBag.UnclassifiedOccCount ?? 0);
    string EPct(int n) => totalEmp > 0 ? (n * 100.0 / totalEmp).ToString("0.#") + "%" : "0%";
}

<div class="page-head">
    <div>
        <h1>@T["Occ_Title"]</h1>
        <div class="subtle">@ViewBag.MappedCount / @ViewBag.TotalOccupations @T["Occ_Mapped"]</div>
    </div>
    @if (snaps.Any())
    {
        <form method="get" style="display:flex;gap:8px;align-items:center">
            <label class="subtle">@T["Dash_Version"]:</label>
            <select name="snapshotId" onchange="this.form.submit()" class="btn-soft" style="padding:6px 10px;border-radius:8px">
                @foreach (var s in snaps) { <option value="@s.Id" selected="@(sid == s.Id)">@s.Label (@s.WeekDate.ToString("yyyy-MM-dd"))</option> }
            </select>
        </form>
    }
</div>

<div class="kpis">
    <div class="kpi"><div class="k-val">@totalEmp</div><div class="k-lbl">@T["Occ_TotalEmp"]</div></div>
    <div class="kpi ok"><div class="k-val">@(totalEmp - unclEmp)</div><div class="k-lbl">@T["Occ_Classified"] · @EPct(totalEmp - unclEmp)</div></div>
    <div class="kpi @(unclEmp > 0 ? "bad" : "")">
        <div class="k-val">@unclEmp</div>
        <div class="k-lbl"><a asp-action="Employees" asp-route-unclassified="true" asp-route-snapshotId="@sid">@T["Occ_Unclassified"] · @EPct(unclEmp) →</a></div>
    </div>
</div>

<div class="card">
    <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
        <strong>@T["Occ_Import"]</strong>
        <a class="btn btn-soft btn-sm" asp-action="GuideTemplate">⭳ @T["Import_Download"]</a>
        <span class="subtle">@T["Occ_TemplateHint"]</span>
    </div>
    <form asp-action="ImportGuide" method="post" enctype="multipart/form-data" style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:10px">
        @Html.AntiForgeryToken()
        <input type="file" name="file" accept=".xlsx" required />
        <button class="btn btn-sm" type="submit">⭱ @T["Occ_Apply"]</button>
        <span class="subtle">@T["Occ_ImportHint"]</span>
    </form>
</div>

@if (guide.Any())
{
    <div class="card">
        <strong>@T["Occ_Guide"]</strong> <span class="subtle">@T["Occ_ByCatHint"]</span>
        <div class="table-scroll" style="margin-top:10px">
        <table class="grid">
            <thead><tr><th>@T["Occ_Category"]</th><th class="num">@T["Occ_All"]</th><th class="num">@T["Occ_TotalEmp"]</th></tr></thead>
            <tbody>
                @foreach (var g in guide)
                {
                    <tr>
                        <td dir="rtl"><a asp-action="Employees" asp-route-categoryId="@g.CategoryId" asp-route-snapshotId="@sid">@g.Name</a></td>
                        <td class="num">@g.OccCount</td>
                        <td class="num"><a asp-action="Employees" asp-route-categoryId="@g.CategoryId" asp-route-snapshotId="@sid">@g.EmpCount</a></td>
                    </tr>
                }
                @if (unclEmp > 0)
                {
                    <tr class="unmapped-row">
                        <td dir="rtl"><a asp-action="Employees" asp-route-unclassified="true" asp-route-snapshotId="@sid"><strong>@T["Occ_Unclassified"]</strong> · @EPct(unclEmp)</a></td>
                        <td class="num">@unclOcc</td>
                        <td class="num"><a asp-action="Employees" asp-route-unclassified="true" asp-route-snapshotId="@sid">@unclEmp</a></td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>
}

<div class="card">
    <div class="page-head" style="margin-bottom:10px">
        <strong>@T["Occ_All"] (@allOcc.Count)</strong>
        <input id="occSearch" placeholder="@T["Common_Search"]" oninput="occFilter(this.value)"
               style="padding:6px 10px;border-radius:8px;border:1px solid var(--line);min-width:240px" />
    </div>
    <div class="table-scroll" style="max-height:520px;overflow:auto">
    <table class="grid" id="occTable">
        <thead><tr><th style="width:110px">@T["Occ_Code"]</th><th>@T["Occ_Name"]</th><th class="num" style="width:110px">@T["Occ_Employees"]</th><th style="width:300px">@T["Occ_Category"]</th></tr></thead>
        <tbody>
        @foreach (var o in allOcc)
        {
            var catName = cats.FirstOrDefault(c => c.Id == o.CategoryId)?.NameAr;
            <tr class="@(o.CategoryId == null ? "unmapped-row" : "")" data-s="@($"{o.Code} {o.NameAr} {catName}".ToLowerInvariant())">
                <td>@o.Code</td>
                <td dir="rtl">@o.NameAr</td>
                <td class="num">
                    @if (o.EmpCount > 0)
                    {
                        <a asp-action="Employees" asp-route-occupationId="@o.Id" asp-route-snapshotId="@sid">@o.EmpCount</a>
                    }
                    else
                    {
                        <span class="subtle">0</span>
                    }
                </td>
                <td>
                    @* One shared picker (below) is moved into the row on click — instead of a form + select per row. *@
                    <button type="button" class="btn-soft occ-pick" data-name="@o.NameAr" data-cat="@o.CategoryId"
                            style="padding:5px 8px;border-radius:7px;width:100%;text-align:start;border:1px solid var(--line);cursor:pointer">
                        @(catName ?? "— " + T["Occ_Category"].Value + " —") ✎
                    </button>
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>
</div>
<form asp-action="Map" method="post" id="occMapForm" style="display:none">
    <input type="hidden" name="occupationName" id="occMapName" />
    <select name="categoryId" id="occMapSelect" class="btn-soft" style="padding:5px 8px;border-radius:7px;width:100%">
        <option value="">— @T["Occ_Category"] —</option>
        @foreach (var c in cats) { <option value="@c.Id">@c.NameAr</option> }
    </select>
</form>
<script>
    (function () {
        var form = document.getElementById("occMapForm"), sel = document.getElementById("occMapSelect"),
            nameInp = document.getElementById("occMapName"), current = null;
        document.getElementById("occTable").addEventListener("click", function (e) {
            var btn = e.target.closest(".occ-pick");
            if (!btn) return;
            if (current) current.style.display = "";
            current = btn;
            nameInp.value = btn.getAttribute("data-name");
            sel.value = btn.getAttribute("data-cat") || "";
            btn.style.display = "none";
            btn.parentNode.appendChild(form);
            form.style.display = "";
            sel.focus();
        });
        sel.addEventListener("change", function () { if (sel.value) form.submit(); });
    })();
    // search the code, name and category of each row only (not the text of every dropdown option)
    function occFilter(q) {
        q = (q || "").toLowerCase().trim();
        var rows = document.querySelectorAll("#occTable tbody tr");
        for (var i = 0; i < rows.length; i++)
            rows[i].style.display = !q || rows[i].getAttribute("data-s").indexOf(q) >= 0 ? "" : "none";
    }
</script>

<div class="card">
    <strong>@T["Occ_Unmapped"]</strong>
    @if (Model.Count > 0)
    {
        <form asp-action="MapAll" method="post" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:10px;padding:10px;border:1px dashed var(--line);border-radius:8px">
            @Html.AntiForgeryToken()
            <span class="subtle">@T["Occ_AssignAll"]:</span>
            <input name="newCategory" placeholder="@T["Occ_NewCategory"]" style="padding:6px 10px;border-radius:8px;border:1px solid var(--line)" />
            <span class="subtle">@T["Occ_Or"]</span>
            <select name="categoryId" class="btn-soft" style="padding:6px 10px;border-radius:8px">
                <option value="">— @T["Occ_Category"] —</option>
                @foreach (var c in cats) { <option value="@c.Id">@c.NameAr</option> }
            </select>
            <button class="btn btn-sm" type="submit">@T["Occ_Apply"]</button>
        </form>
    }
    @if (Model.Count == 0)
    {
        <p class="subtle" style="margin-top:8px">✓</p>
    }
    else
    {
        <div class="table-scroll" style="margin-top:10px">
        <table class="grid">
            <thead>
                <tr>
                    <th>@T["Occ_Name"]</th>
                    <th class="num">@T["Common_Count"]</th>
                    <th>@T["Occ_Category"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td dir="rtl"><a asp-action="Employees" asp-route-occupation="@u.Name" asp-route-snapshotId="@sid">@u.Name</a></td>
                    <td class="num">@u.Count</td>
                    <td colspan="2">
                        <form asp-action="Map" method="post" style="display:flex;gap:8px;align-items:center">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="occupationName" value="@u.Name" />
                            <select name="categoryId" class="btn-soft" style="padding:6px 10px;border-radius:8px" required>
                                <option value="">— @T["Occ_Category"] —</option>
                                @foreach (var c in cats) { <option value="@c.Id">@c.NameAr</option> }
                            </select>
                            <button class="btn btn-sm" type="submit">@T["Common_Save"]</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
        </div>
    }
</div>
