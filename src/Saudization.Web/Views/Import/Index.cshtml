@{ ViewData["Title"] = T["Import_Title"].Value; }
<div class="page-head"><h1>@T["Import_Title"]</h1></div>

<div class="section-head"><h2>@T["Import_SecSaud"]</h2></div>
<div class="card">
    <p class="subtle">@T["Import_Intro"]</p>

    <div class="field" style="max-width:520px">
        <label>@T["Import_Rule"]</label>
        <select id="ruleSel" name="rule" form="importForm" class="btn-soft" style="padding:8px 10px;border-radius:8px">
            <option value="PerFacility">@T["Import_RulePerFacility"]</option>
            <option value="PerRegistration">@T["Import_RulePerReg"]</option>
        </select>
        <span class="hint">@T["Import_RuleHelp"]</span>
    </div>

    <div style="margin:12px 0;display:flex;gap:8px;align-items:center;flex-wrap:wrap">
        <span class="hint">⭳ @T["Import_Download"]:</span>
        <button type="button" class="btn btn-soft dlTemplate" data-mode="data">@T["Import_TplData"]</button>
        <button type="button" class="btn btn-soft dlTemplate" data-mode="empty">@T["Import_TplEmpty"]</button>
        <button type="button" class="btn btn-soft dlTemplate" data-mode="sample">@T["Import_TplSample"]</button>
        <span class="hint">@T["Import_TemplateHelp"]</span>
    </div>

    <form id="importForm" asp-action="Index" method="post" enctype="multipart/form-data" class="stack" style="margin-top:8px">
        @Html.AntiForgeryToken()
        <div class="row3">
            <div class="field">
                <label>@T["Import_Label"]</label>
                <input name="label" value="@ViewBag.DefaultLabel" />
            </div>
            <div class="field">
                <label>@T["Import_Week"]</label>
                <input name="weekDate" type="date" value="@ViewBag.DefaultWeek" />
            </div>
            <div class="field">
                <label>@T["Import_Note"]</label>
                <input name="note" />
            </div>
        </div>
        <div class="field">
            <label>@T["Import_Choose"]</label>
            <input type="file" name="file" accept=".xlsx" required />
        </div>
        <div class="field" style="background:#fff8e6;border:1px solid #f0d98a;border-radius:8px;padding:10px 12px">
            <label style="display:flex;align-items:center;gap:8px;font-weight:600">
                <input type="checkbox" name="updateMaster" value="true" style="width:auto" />
                @T["Import_UpdateMaster"]
            </label>
            <span class="hint">@T["Import_UpdateMasterHelp"]</span>
        </div>
        <div class="form-actions">
            <button class="btn" type="submit">@T["Import_Run"]</button>
        </div>
    </form>
</div>

<div class="section-head"><h2>@T["Import_SecOrg"]</h2></div>
<div class="card">
    <p class="subtle">@T["Org_ImportIntro"]</p>
    <div style="margin:10px 0">
        <a class="btn btn-soft" asp-controller="Restructure" asp-action="Template">⭳ @T["Import_Download"]</a>
        <span class="hint">@T["Org_TemplateHelp"]</span>
    </div>
    <form asp-controller="Restructure" asp-action="Import" method="post" enctype="multipart/form-data" class="stack" style="margin-top:8px">
        @Html.AntiForgeryToken()
        <div class="field" style="max-width:420px">
            <label>@T["Import_Label"]</label>
            <input name="label" placeholder="Original" />
        </div>
        <div class="field">
            <label>@T["Import_Choose"]</label>
            <input type="file" name="file" accept=".xlsx" required />
        </div>
        <div class="form-actions"><button class="btn" type="submit">@T["Import_Run"]</button></div>
    </form>
</div>

@section Scripts {
<script>
  document.querySelectorAll(".dlTemplate").forEach(function (btn) {
    btn.addEventListener("click", function () {
      var rule = document.getElementById("ruleSel").value;
      window.location = "@Url.Action("Template")?rule=" + encodeURIComponent(rule) + "&mode=" + encodeURIComponent(btn.getAttribute("data-mode"));
    });
  });
</script>
}
